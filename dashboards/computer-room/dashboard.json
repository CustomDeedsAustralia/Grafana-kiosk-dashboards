{
  "dashboard": {
    "uid": "kiosk-computer-room",
    "title": "Kiosk — Computer Room",
    "tags": [
      "kiosk",
      "computer-room"
    ],
    "timezone": "UTC",
    "refresh": "30s",
    "time": {
      "from": "now-12h",
      "to": "now"
    },
    "timepicker": {
      "hidden": true
    },
    "graphTooltip": 0,
    "schemaVersion": 42,
    "panels": [
      {
        "id": 2,
        "type": "stat",
        "title": "Rack power",
        "description": "Current power consumption of the configured rack power sensor.",
        "gridPos": {
          "h": 8,
          "w": 5,
          "x": 0,
          "y": 0
        },
        "datasource": {
          "type": "influxdb",
          "uid": "replace-with-your-influxdb-datasource-uid"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "replace-with-your-influxdb-datasource-uid"
            },
            "queryType": "flux",
            "query": "import \"timezone\"\n\noption location = timezone.location(name: \"UTC\")\n\nfrom(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.domain == \"sensor\")\n  |> filter(fn: (r) => r.entity_id == \"rack_power\")\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)\n  |> group(columns: [\"_field\"])"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "watt",
            "decimals": 0,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 200
                },
                {
                  "color": "red",
                  "value": 350
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "value",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "center"
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Energy today",
        "gridPos": {
          "h": 8,
          "w": 5,
          "x": 5,
          "y": 0
        },
        "datasource": {
          "type": "influxdb",
          "uid": "replace-with-your-influxdb-datasource-uid"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "replace-with-your-influxdb-datasource-uid"
            },
            "queryType": "flux",
            "query": "import \"timezone\"\n\noption location = timezone.location(name: \"UTC\")\n\nfrom(bucket: \"homeassistant\")\n  |> range(start: -2h)\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.domain == \"sensor\")\n  |> filter(fn: (r) => r.entity_id == \"rack_energy_today\")\n  |> last()\n  |> group(columns: [\"_field\"])"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "kwatth",
            "decimals": 2,
            "color": {
              "mode": "fixed",
              "fixedColor": "#E02F44"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "value",
          "colorMode": "value",
          "graphMode": "none",
          "justifyMode": "center"
        }
      },
      {
        "id": 1,
        "type": "timeseries",
        "title": "Rack environment & UPS",
        "gridPos": {
          "h": 8,
          "w": 14,
          "x": 10,
          "y": 0
        },
        "datasource": {
          "type": "influxdb",
          "uid": "replace-with-your-influxdb-datasource-uid"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "influxdb",
              "uid": "replace-with-your-influxdb-datasource-uid"
            },
            "queryType": "flux",
            "query": "import \"timezone\"\n\noption location = timezone.location(name: \"UTC\")\n\nfrom(bucket: \"homeassistant\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._field == \"value\")\n  |> filter(fn: (r) => r.domain == \"sensor\")\n  |> filter(fn: (r) =>\n    r.entity_id == \"rack_temperature\" or\n    r.entity_id == \"rack_humidity\" or\n    r.entity_id == \"ups_load\" or\n    r.entity_id == \"rack_power\"\n  )\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({\n    r with\n    _field:\n      if r.entity_id == \"rack_temperature\" then \"°C Rack temp\"\n      else if r.entity_id == \"rack_humidity\" then \"% Rack humidity\"\n      else if r.entity_id == \"ups_load\" then \"% UPS load\"\n      else if r.entity_id == \"rack_power\" then \"W Rack power\"\n      else r.entity_id\n  }))\n  |> group(columns: [\"_field\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> yield(name: \"computer_room_rack\")"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 12,
              "showPoints": "never",
              "spanNulls": true,
              "axisGridShow": false
            },
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "°C Rack temp"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "celsius"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  }
                },
                {
                  "id": "custom.axisPlacement",
                  "value": "left"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "% Rack humidity"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                },
                {
                  "id": "custom.axisPlacement",
                  "value": "right"
                },
                {
                  "id": "min",
                  "value": 0
                },
                {
                  "id": "max",
                  "value": 100
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "% UPS load"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                },
                {
                  "id": "custom.axisPlacement",
                  "value": "right"
                },
                {
                  "id": "min",
                  "value": 0
                },
                {
                  "id": "max",
                  "value": 100
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "W Rack power"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "watt"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "purple"
                  }
                },
                {
                  "id": "custom.axisPlacement",
                  "value": "right"
                },
                {
                  "id": "min",
                  "value": 0
                },
                {
                  "id": "custom.fillOpacity",
                  "value": 0
                },
                {
                  "id": "custom.lineWidth",
                  "value": 2
                }
              ]
            }
          ]
        },
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom",
            "showLegend": true,
            "calcs": [
              "lastNotNull"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "none"
          }
        }
      }
    ]
  },
  "overwrite": true,
  "message": "Build configurable computer-room kiosk dashboard"
}
