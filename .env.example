# Optional deployment settings used by scripts/deploy.ps1
GRAFANA_URL=http://localhost:3000
GRAFANA_SERVICE_ACCOUNT_TOKEN=replace-with-a-grafana-service-account-token

# Shared Grafana/InfluxDB settings
INFLUXDB_DATASOURCE_UID=replace-with-your-influxdb-datasource-uid
INFLUXDB_BUCKET=homeassistant
DASHBOARD_TIMEZONE=UTC

# UniFi switch presentation
UNIFI_DASHBOARD_UID=kiosk-unifi-switch
UNIFI_DEVICE_NAME=UniFi Switch
UNIFI_UPLINK_LABEL=UPLINK PORT
UNIFI_HARDWARE_REVISION=N/A
UNIFI_MAC_ADDRESS=00:00:00:00:00:00
UNIFI_MODEL=Unknown model

# UniFi switch Home Assistant/InfluxDB entity IDs
UNIFI_UPLINK_RX_ENTITY=unifi_switch_uplink_rx
UNIFI_UPLINK_TX_ENTITY=unifi_switch_uplink_tx
UNIFI_CPU_ENTITY=unifi_switch_cpu_utilisation
UNIFI_MEMORY_ENTITY=unifi_switch_memory_utilisation
UNIFI_CLIENTS_ENTITY=unifi_switch_clients
UNIFI_LINK_SPEED_ENTITY=unifi_switch_uplink_speed
UNIFI_STATE_ENTITY=unifi_switch_state
UNIFI_UPTIME_ENTITY=unifi_switch_uptime
UNIFI_FIRMWARE_ENTITY=unifi_switch_firmware

# Daily energy-flow entity IDs
ENERGY_SOLAR_GENERATION_ENTITY=solar_generation_daily
ENERGY_GRID_EXPORT_ENTITY=grid_export_daily
ENERGY_GRID_IMPORT_ENTITY=grid_import_daily

# Computer-room entity IDs
ROOM_RACK_POWER_ENTITY=rack_power
ROOM_RACK_ENERGY_TODAY_ENTITY=rack_energy_today
ROOM_TEMPERATURE_ENTITY=rack_temperature
ROOM_HUMIDITY_ENTITY=rack_humidity
ROOM_UPS_LOAD_ENTITY=ups_load
ROOM_POWER_WARNING_WATTS=200
ROOM_POWER_CRITICAL_WATTS=350
